# Copy to deploy/.env.test. No production credentials or data belong here.
APP_IMAGE=customer-chat-analysis-center:lan-test
APP_VERSION=0.1.0-test
APP_COMMIT_SHA=local-test
APP_BUILD_TIME=local
APP_CONTAINER_NAME=customer-chat-analysis-test
APP_PORT=8789

ALLOWED_HOSTS=chat-test.example.invalid
ALLOWED_ORIGINS=http://chat-test.example.invalid:8444
SESSION_COOKIE_SECURE=false
LAN_BIND_ADDRESS=192.0.2.10
LAN_PROXY_CONTAINER_NAME=customer-chat-analysis-test-proxy

DEPLOY_DATA_DIR=./test-data
DEPLOY_KNOWLEDGE_DIR=./test-knowledge
APP_MEMORY_LIMIT=1g
APP_CPU_LIMIT=1.0
MAX_UPLOAD_MB=256
ANALYSIS_CONCURRENCY=1
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=
