# 复制为 deploy/.env 后填写真实值；本文件不包含任何真实密钥。

# 镜像：固定到发布版本，回滚时改回上一个标签。
APP_IMAGE=customer-chat-analysis:lan-2026-09-17

# 宿主机端口：应用在容器内监听 0.0.0.0:8787，宿主机只发布到 127.0.0.1，
# 由内网反向代理/TLS 终止器对外提供服务；不要把该端口暴露到公网。
APP_PORT=8787

# 必须提供：模型凭据加密密钥（独立值，勿与示例或旧默认值相同）。
ENCRYPTION_KEY=

# 内网入口：允许访问应用的 Host 主机名与浏览器 Origin（逗号分隔，可多个）。
# 反向代理必须保留原始 Host，浏览器地址栏需与 ALLOWED_ORIGINS 完全一致。
ALLOWED_HOSTS=chat.example.lan
ALLOWED_ORIGINS=https://chat.example.lan

# 会话有效期（小时）与 Cookie 是否要求 HTTPS。内网 HTTPS 部署保持 true；
# 仅在无 TLS 的临时环境才设为 false。
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true

# 首次管理员（仅首次启动、且系统还没有任何账号时生效）：同时填写账号与密码
# （至少 8 位），显示名可省略。首次成功登录后请删除密码配置并重启容器；
# 也可改用文档中的 docker exec 引导命令。
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=
# FIRST_ADMIN_DISPLAY_NAME=管理员

# 宿主机本地持久目录（不要放在网络共享盘）。
DEPLOY_DATA_DIR=./data
DEPLOY_KNOWLEDGE_DIR=./knowledge

# 资源限制。
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2.0

# 业务参数（可按主机调整）。
MAX_UPLOAD_MB=2048
ANALYSIS_CONCURRENCY=2
ANALYSIS_BATCH_SIZE=20
MIN_FREE_DISK_MB=512
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
CLEANUP_RETENTION_DAYS=14
LOG_MAX_MB=10
LOG_RETENTION=7
