PORT=8787
DATA_DIR=./data
DATABASE_PATH=./data/app.db
# New installs generate a private key beside the database: .secrets/<database-name>.key.json.
# Back up that file separately; full backups exclude it. Never commit it to Git.
# Existing independent ENCRYPTION_KEY values still take priority; preserve the original value.
# Legacy default-key databases: stop the server and run npm run keys:migrate -- --apply.
# Session lifetime (hours) and whether the session cookie requires HTTPS.
# SESSION_COOKIE_SECURE=false is only for plain-HTTP LAN fallback; the LAN release uses HTTPS.
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
# 首次管理员（仅首次启动、且系统还没有任何账号时生效）：
# 同时填写 FIRST_ADMIN_USERNAME 与 FIRST_ADMIN_PASSWORD（至少 8 位），
# FIRST_ADMIN_DISPLAY_NAME 可省略。首次成功登录后请立即删除上面两行密码配置并重启。
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=
# FIRST_ADMIN_DISPLAY_NAME=管理员
MAX_UPLOAD_MB=2048
ANALYSIS_CONCURRENCY=2
ANALYSIS_BATCH_SIZE=20
MIN_FREE_DISK_MB=512
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
CLEANUP_RETENTION_DAYS=14
LOG_MAX_MB=10
LOG_RETENTION=7
