PORT=8787
DATA_DIR=./data
DATABASE_PATH=./data/app.db
# New installs generate a private key beside the database: .secrets/<database-name>.key.json.
# Back up that file separately; full backups exclude it. Never commit it to Git.
# Existing independent ENCRYPTION_KEY values still take priority; preserve the original value.
# Legacy default-key databases: stop the server and run npm run keys:migrate -- --apply.
# SESSION_SECRET: required by the LAN session unit; keep it unique and out of Git.
SESSION_SECRET=
MAX_UPLOAD_MB=2048
ANALYSIS_CONCURRENCY=2
ANALYSIS_BATCH_SIZE=20
MIN_FREE_DISK_MB=512
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
CLEANUP_RETENTION_DAYS=14
LOG_MAX_MB=10
LOG_RETENTION=7
